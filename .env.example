# App configuration
APP_NAME=pod_render
APP_IMAGE=ghcr.io/quyle91/pod-render
APP_VERSION=latest
APP_DOMAIN=render.localhost
PROD_DOMAIN=render.quyle91.net
PORT=3001

# Security
SHARED_SECRET=your_pod_secret_token_here

# Network & Volumes
VOLUME_STORAGE=pod_render_storage
INTERNAL_NETWORK=internal_network
FRONTEND_INTERNAL_URL=http://pod_web
